generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres, for compatibility with serverless hosts like Vercel (no writable
  // filesystem for SQLite there). Point DATABASE_URL at a free instance
  // (Neon, Supabase) for production, or any local/self-hosted Postgres for dev.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Plan: "FREE" | "PREMIUM"
// Role: "USER" | "ADMIN"
// SubscriptionProvider: "RAZORPAY" | "PAYPAL"
// SubscriptionStatus: "ACTIVE" | "CANCELLED" | "PAST_DUE" | "EXPIRED"

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  displayName   String?
  bio           String?
  avatarUrl     String?
  plan          String    @default("FREE")
  role          String    @default("USER")
  suspended     Boolean   @default(false)
  resetTokenHash String?
  resetTokenExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  links         Link[]
  theme         Theme?
  subscriptions Subscription[]
  reports       Report[]
}

model Link {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  url       String
  emoji     String?
  kind      String   @default("LINK") // LINK | SOCIAL
  platform  String? // instagram | twitter | youtube | tiktok | facebook | linkedin | github | email | website | other (SOCIAL only)
  order     Int      @default(0)
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports   Report[]
}

model Theme {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  backgroundColor String   @default("#f4f7f0")
  buttonColor     String   @default("#123524")
  buttonTextColor String   @default("#ffffff")
  textColor       String   @default("#0d2a1c")
  fontFamily      String   @default("Inter, sans-serif")
  buttonStyle     String   @default("rounded") // rounded | square | pill
  backgroundImage String? // premium only
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  providerSubId    String?   @unique
  status           String    @default("ACTIVE")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Template {
  id              String   @id @default(cuid())
  name            String
  backgroundColor String   @default("#f4f7f0")
  buttonColor     String   @default("#123524")
  buttonTextColor String   @default("#ffffff")
  textColor       String   @default("#0d2a1c")
  buttonStyle     String   @default("rounded") // rounded | square | pill
  backgroundImage String?
  premiumOnly     Boolean  @default(false)
  active          Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Single-row table (fixed id "singleton"). Read/written via lib/settings.ts.
model PlatformSettings {
  id                String   @id @default("singleton")
  freePlanLinkLimit Int      @default(5)
  premiumPriceINR   Int      @default(199)
  premiumPriceUSD   Int      @default(3)
  signupsEnabled    Boolean  @default(true)
  maintenanceMode   Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// ReportType: "LINK" | "PROFILE"
// ReportStatus: "OPEN" | "RESOLVED" | "DISMISSED"
model Report {
  id        String   @id @default(cuid())
  type      String
  userId    String // the reported profile's owner
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkId    String? // set when type = "LINK"
  link      Link?    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reason    String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
