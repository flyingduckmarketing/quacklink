# Database (SQLite for local/cheap hosting; swap to a Postgres URL like Neon/Supabase in prod)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Razorpay (sandbox keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PREMIUM_PLAN_ID=""

# PayPal (sandbox app from https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_PREMIUM_PLAN_ID=""
PAYPAL_WEBHOOK_ID=""

APP_URL="http://localhost:3000"
